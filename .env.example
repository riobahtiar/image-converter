# Session Management
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your-random-32-character-or-longer-secret-key-here

# Redis Configuration (for Rate Limiting & Caching)
# Format: redis://[username]:[password]@[host]:[port]/[database]
#
# Examples:
#   Local Redis: redis://localhost:6379/0
#   With password: redis://:mypassword@localhost:6379/0
#   Remote Redis: redis://username:password@redis.example.com:6379/0
#
# Leave empty to use in-memory adapter (development only, not for production!)
REDIS_URL=redis://localhost:6379/0

# File Cache Settings
# How long to keep converted files before automatic cleanup (in minutes)
CACHE_MAX_AGE_MINUTES=15

# Optional: Development settings
NODE_ENV=development
